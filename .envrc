# Auto-loaded by direnv (run `direnv allow` once after cloning).
# sops on macOS defaults to "~/Library/Application Support/sops/age" — point it
# at the conventional key location so `sops`/ansible runs just work.
if [ -f "$HOME/.config/sops/age/keys.txt" ]; then
  export SOPS_AGE_KEY_FILE="$HOME/.config/sops/age/keys.txt"
fi

# Project venv (uv-managed; see README) — makes `ansible-playbook` resolve to
# the repo's pinned toolchain instead of whatever brew happens to ship.
if [ -d ansible/.venv/bin ]; then
  PATH_add ansible/.venv/bin
fi
