// RENDERED from ansible/inventory/hosts.yml — do not edit by hand.
// RouterOS remote syslog + host journal → Loki.
// Devices send BSD syslog (rfc3164) to 44.34.128.45:514 (configured by the
// routeros_baseline logging tasks). Device identity comes from the syslog
// hostname field, with the sending IP kept as src_ip; MikroTik's
// "topic1,topic2,severity message" prefix becomes a bounded `topic` label.
{# accept full FQDNs and short host.site forms only. Identities are never
   bare hostnames by design — bare names aren't site-unique (seven r1.*), so
   a bare sender is a misconfiguration and gets dropped, surfacing as missing
   logs instead of logs mis-attributed to another site. #}
{% set fleet_names = [] %}
{% for h in groups['routeros'] | sort %}
{% if fleet_names.append(h) %}{% endif %}
{% if fleet_names.append(h | replace('.memhamwan.net', '')) %}{% endif %}
{% endfor %}

loki.source.syslog "routeros" {
	listener {
		address                = "0.0.0.0:514"
		protocol               = "udp"
		syslog_format          = "rfc3164"
		use_incoming_timestamp = false
		labels                 = { job = "routeros-syslog" }
	}
	listener {
		address                = "0.0.0.0:514"
		protocol               = "tcp"
		syslog_format          = "rfc3164"
		use_incoming_timestamp = false
		labels                 = { job = "routeros-syslog" }
	}
	relabel_rules = loki.relabel.syslog.rules
	forward_to    = [loki.process.routeros.receiver]
}

loki.relabel "syslog" {
	forward_to = []
	// second gate behind the DOCKER-USER source filter: only hostnames that
	// look like fleet devices are accepted, so internet noise and spoofed
	// senders can't mint arbitrary label values (loki cardinality)
	rule {
		source_labels = ["__syslog_message_hostname"]
		regex         = "(?i)({{ fleet_names | unique | map('replace', '.', '\\\\.') | join('|') }})"
		action        = "keep"
	}
	rule {
		source_labels = ["__syslog_message_hostname"]
		target_label  = "host"
	}
	rule {
		source_labels = ["__syslog_connection_ip_address"]
		target_label  = "src_ip"
	}
	rule {
		source_labels = ["__syslog_message_severity"]
		target_label  = "severity"
	}
	// the raw RouterOS topic list (syslog tag) is deliberately NOT kept as a
	// label: it's untrusted, unbounded input and each distinct value would
	// mint a loki stream — the bounded `topic` label below covers queries
}

loki.process "routeros" {
	// people fat-finger passwords into the username field, and anonymous
	// grafana can query loki — never ship attempted usernames. No capture
	// group on purpose: the whole match is replaced with the full phrase,
	// which behaves identically under either reading of stage.replace
	// semantics, and dashboard |= "login failure" filters keep matching
	stage.replace {
		expression = "login failure for user \\S+"
		replace    = "login failure for user <redacted>"
	}
	// first topic only, and only from a fixed vocabulary, so an
	// unauthenticated sender can't mint arbitrary label values (streams);
	// lines with other topics simply carry no topic label
	stage.regex {
		expression = "^(?P<topic>(system|error|warning|critical|info|account|interface|firewall|ospf|route|dhcp|wireless|dns|ntp|ssh|script|state|timer|vrrp|bridge|certificate|event|radius|watchdog|l2tp|ipsec|pppoe))[, ]"
	}
	stage.labels {
		values = { topic = "" }
	}
	forward_to = [loki.write.local.receiver]
}

loki.source.journal "host" {
	// allowlist, not the whole journal: loki is queryable via anonymous
	// grafana, and sshd/sudo/auth lines expose usernames and worse. Only the
	// units whose health the dashboards actually track are shipped; the full
	// journal stays on the host (journalctl). Filtered via relabel keep —
	// `matches` can't express OR (space-separated matches AND together, and
	// alloy doesn't support journalctl's `+` disjunction).
	relabel_rules = loki.relabel.journal.rules
	labels        = { job = "journald", host = "rpi.sco" }
	forward_to    = [loki.write.local.receiver]
}

loki.relabel "journal" {
	forward_to = []
	rule {
		source_labels = ["__journal__systemd_unit"]
		regex         = "(docker|netops-full-backup|netops-oxidized-metrics|netops-firewall)\\.service"
		action        = "keep"
	}
	rule {
		source_labels = ["__journal__systemd_unit"]
		target_label  = "unit"
	}
}

loki.write "local" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
