# Public (44net) entrypoint for the netops apps, with automatic Let's Encrypt.
# Grafana handles its own auth (anonymous = read-only Viewer); Prometheus and
# Alertmanager have none, so they sit behind basic auth — credentials in
# /var/lib/netops/secrets/caddy-auth.snippet (see deploy.sh), never in git.
{
	email ryan@turnrye.com
}

grafana.memhamwan.net {
	reverse_proxy grafana:3000
}

prometheus.memhamwan.net {
	import /run/secrets/caddy-auth.snippet
	reverse_proxy prometheus:9090
}

alertmanager.memhamwan.net {
	import /run/secrets/caddy-auth.snippet
	reverse_proxy alertmanager:9093
}
