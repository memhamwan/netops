#!/bin/sh
# RENDERED by the netops site_services role — do not edit on the host.
#
# Signs the FORWARD zone ({{ dns_zone }}) with the shared CSK and, unless
# --no-reload, reloads NSD. Run once at deploy (by the role, --no-reload, because
# NSD starts later at the :53 hand-off) and weekly by netops-nsd-resign.timer so
# RRSIGs never expire. Each anycast node signs independently with the SAME key:
# the RRSIGs differ per node but all validate under the one shared DNSKEY.
# Reverse zones are not signed here (44Net delegates them). See
# docs/dns-authority-design.md.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin

ZONE="{{ dns_zone }}"
ZONEDIR="/etc/nsd/zones"
KEY="{{ dnssec_key_dir }}/{{ dnssec_csk_basename }}"

RELOAD=1
[ "${1:-}" = "--no-reload" ] && RELOAD=0

# Absolute expiration so the resign cadence is knowable; inception defaults to
# ~now. ldns-signzone accepts YYYYMMDDhhmmss. The timer runs far inside this
# window ({{ dnssec_resign_on_calendar }}, validity {{ dnssec_rrsig_validity_days }}d).
EXP=$(date -u -d "+{{ dnssec_rrsig_validity_days }} days" +%Y%m%d%H%M%S)

# ldns-signzone writes "$ZONEDIR/$ZONE.zone.signed" (input path + .signed), which
# is exactly what nsd.conf serves in DNSSEC mode.
ldns-signzone -e "$EXP" -o "$ZONE" "$ZONEDIR/$ZONE.zone" "$KEY"
nsd-checkzone "$ZONE" "$ZONEDIR/$ZONE.zone.signed"

if [ "$RELOAD" -eq 1 ]; then
  # reload if the unit supports it, else a brief restart — the OTHER anycast
  # node keeps answering during the blip (the timer is randomized-delayed so the
  # two nodes never resign at the same instant).
  systemctl reload-or-restart nsd
fi
