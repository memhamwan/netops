#!/bin/sh
# RENDERED by the netops site_services role — do not edit on the host.
#
# Single authority on which anycast service addresses exist on this host.
# Health-checks each service, adds/removes its addresses on the dummy
# interface, and writes node-exporter textfile metrics. frr withdraws the
# connected route by itself when an address disappears — nothing here
# reconfigures the routing daemon.
#
# With anycast disabled (M1) it still runs and still writes every metric; it
# just never touches an address. That way monitoring is proven before routing
# is switched on.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin

TEXTFILE_DIR="{{ site_services_textfile_dir }}"
STATE_DIR="{{ site_services_var }}"
ANYCAST_ENABLED={{ 1 if anycast_enabled | bool else 0 }}
ANYCAST_IF="{{ anycast_interface }}"
ZONE_FILE=/etc/unbound/unbound.conf.d/netops-zone.conf

DNS_PROBE_NAME="{{ dns_probe_name }}"
DNS_PROBE_EXPECT="{{ dns_probe_expect }}"
RECURSION_PROBE_NAME="{{ dns_recursion_probe_name }}"

DNS_IPS="{{ anycast_services | selectattr('service', 'eq', 'dns') | map(attribute='ip') | join(' ') }}"
NTP_IPS="{{ anycast_services | selectattr('service', 'eq', 'ntp') | map(attribute='ip') | join(' ') }}"
# Short names of every enrolled service host. An anycast answer from anything
# else is the split-brain signal (e.g. the legacy LEB hosts coming back).
KNOWN_ORIGINS="{% for h in groups['service_hosts'] | sort %}{{ h | replace('.' ~ dns_zone, '') }} {% endfor %}"
# Other service hosts, probed by their own addresses for the reciprocal view.
PEERS="{% for h in groups['service_hosts'] | sort %}{% if h != inventory_hostname %}{{ h | replace('.' ~ dns_zone, '') }}={{ hostvars[h].ip | default(h) }} {% endif %}{% endfor %}"

DIG="dig -4 +time=2 +tries=1 +short"
now=$(date +%s)

# ── health checks ────────────────────────────────────────────────────────
# Internal-zone probe: deliberately independent of upstream connectivity, so
# an internet outage never withdraws a resolver (internal names still resolve,
# and withdrawing everywhere would leave the network with none).
dns_healthy=0
answer=$($DIG @127.0.0.1 "$DNS_PROBE_NAME" A 2>/dev/null | head -1 || true)
[ "$answer" = "$DNS_PROBE_EXPECT" ] && dns_healthy=1

# Recursion is reported, never gating.
recursion_healthy=0
if [ -n "$($DIG @127.0.0.1 "$RECURSION_PROBE_NAME" A 2>/dev/null | head -1 || true)" ]; then
  recursion_healthy=1
fi

# chrony CSV: refid,refname,stratum,reftime,systime_offset,last_offset,
# rms_offset,freq,resid_freq,skew,root_delay,root_disp,update_interval,leap
ntp_healthy=0
ntp_offset=0
ntp_stratum=0
ntp_local_mode=0
tracking=$(chronyc -n -c tracking 2>/dev/null || true)
if [ -n "$tracking" ]; then
  refid=$(printf '%s' "$tracking" | cut -d, -f1)
  ntp_stratum=$(printf '%s' "$tracking" | cut -d, -f3)
  ntp_offset=$(printf '%s' "$tracking" | cut -d, -f5)
  leap=$(printf '%s' "$tracking" | cut -d, -f14)
  # "Normal" covers both a disciplined clock and orphan/local mode; only an
  # actually unsynchronised daemon is unhealthy.
  [ "$leap" = "Normal" ] && ntp_healthy=1
  # 7F7F0101 is chrony's local reference — running on `local stratum` because
  # every upstream is unreachable. Expected when a site is islanded, and it
  # must be reported as such, not as a fault.
  #
  # ONLY that refid counts. 00000000 (and an empty field) means the daemon is
  # not synchronised at all, which is the opposite condition — treating it as
  # orphan mode would raise the informational ChronyOrphanMode alert during a
  # real outage and paper over ChronyUnsynchronised. Requiring leap=Normal as
  # well means "actively serving from the local reference", not merely
  # "claiming a local refid while unsynchronised".
  if [ "$refid" = "7F7F0101" ] && [ "$ntp_healthy" -eq 1 ]; then
    ntp_local_mode=1
  fi
fi

# ── announcement state ───────────────────────────────────────────────────
# Adds/removes the address and records transitions. With anycast disabled the
# desired state is still computed and exported, just not applied.
# Results come back in these two globals rather than on stdout: two return
# values through word-splitting is exactly the kind of thing that breaks
# quietly later.
announced=0
announced_since=0
announce() {
  _ip=$1
  _want=$2
  _present=0
  # -F (fixed string): the dots in $_ip are literal, not regex wildcards, so
  # 44.34.132.1/32 can never spuriously match a sibling like 44.34.132.13/32.
  # This decides add/del, so a false positive would leave an address stranded.
  if ip -4 addr show dev "$ANYCAST_IF" 2>/dev/null | grep -qF "inet $_ip/32"; then
    _present=1
  fi

  if [ "$ANYCAST_ENABLED" -eq 1 ]; then
    if [ "$_want" -eq 1 ] && [ "$_present" -eq 0 ]; then
      ip addr add "$_ip/32" dev "$ANYCAST_IF" && _present=1
    elif [ "$_want" -eq 0 ] && [ "$_present" -eq 1 ]; then
      ip addr del "$_ip/32" dev "$ANYCAST_IF" && _present=0
    fi
  fi

  # Transition bookkeeping drives the flap alert.
  _state_file="$STATE_DIR/announce-$_ip"
  _last=$(cut -d' ' -f1 "$_state_file" 2>/dev/null || echo "")
  _since=$(cut -d' ' -f2 "$_state_file" 2>/dev/null || echo "$now")
  if [ "$_last" != "$_present" ]; then
    _since=$now
    printf '%s %s\n' "$_present" "$now" > "$_state_file"
  fi

  announced=$_present
  announced_since=$_since
}

# ── metrics ──────────────────────────────────────────────────────────────
tmp="$TEXTFILE_DIR/netops-site-services.prom.$$"
: > "$tmp"
# A previous run killed mid-write could leave stale transition lines behind.
rm -f "$STATE_DIR/since.tmp"

{
  echo "# HELP netops_service_healthy Service health as evaluated by the anycast health check."
  echo "# TYPE netops_service_healthy gauge"
  echo "netops_service_healthy{service=\"dns\"} $dns_healthy"
  echo "netops_service_healthy{service=\"ntp\"} $ntp_healthy"
  echo "# HELP netops_dns_recursion_healthy External name resolvable (reported only — never withdraws an address)."
  echo "# TYPE netops_dns_recursion_healthy gauge"
  echo "netops_dns_recursion_healthy $recursion_healthy"
  echo "# HELP netops_anycast_enabled 1 when this host is configured to announce service addresses."
  echo "# TYPE netops_anycast_enabled gauge"
  echo "netops_anycast_enabled $ANYCAST_ENABLED"
  echo "# HELP netops_chrony_offset_seconds System time offset reported by chronyc tracking."
  echo "# TYPE netops_chrony_offset_seconds gauge"
  echo "netops_chrony_offset_seconds $ntp_offset"
  echo "# HELP netops_chrony_stratum Stratum reported by chronyc tracking."
  echo "# TYPE netops_chrony_stratum gauge"
  echo "netops_chrony_stratum $ntp_stratum"
  echo "# HELP netops_chrony_local_mode 1 when chrony is running on its local/orphan reference (site islanded)."
  echo "# TYPE netops_chrony_local_mode gauge"
  echo "netops_chrony_local_mode $ntp_local_mode"
} >> "$tmp"

{
  echo "# HELP netops_anycast_announced 1 when the service address is present on the anycast interface."
  echo "# TYPE netops_anycast_announced gauge"
} >> "$tmp"
for _ip in $DNS_IPS; do
  announce "$_ip" "$dns_healthy"
  echo "netops_anycast_announced{service=\"dns\",ip=\"$_ip\"} $announced" >> "$tmp"
  echo "netops_anycast_since{service=\"dns\",ip=\"$_ip\"} $announced_since" >> "$STATE_DIR/since.tmp"
done
for _ip in $NTP_IPS; do
  announce "$_ip" "$ntp_healthy"
  echo "netops_anycast_announced{service=\"ntp\",ip=\"$_ip\"} $announced" >> "$tmp"
  echo "netops_anycast_since{service=\"ntp\",ip=\"$_ip\"} $announced_since" >> "$STATE_DIR/since.tmp"
done
{
  echo "# HELP netops_anycast_since Unix time of the last announce/withdraw transition."
  echo "# TYPE netops_anycast_since gauge"
  cat "$STATE_DIR/since.tmp" 2>/dev/null || true
} >> "$tmp"
rm -f "$STATE_DIR/since.tmp"

# Which instance answers each anycast DNS address, and is it one of ours?
# While this host announces the address the answer is itself — the check only
# becomes a real cross-site view with a second service host (M3). Its value
# before then is the unknown-origin case: an answer from something we did not
# deploy (the legacy LEB resolvers returning) is a split brain.
{
  echo "# HELP netops_anycast_origin_known 1 when the instance answering an anycast address is an enrolled service host."
  echo "# TYPE netops_anycast_origin_known gauge"
} >> "$tmp"
for _ip in $DNS_IPS; do
  origin=$($DIG @"$_ip" CH TXT hostname.bind 2>/dev/null | tr -d '"' | head -1 || true)
  known=0
  [ -z "$origin" ] && origin=unreachable
  for _k in $KNOWN_ORIGINS; do
    [ "$origin" = "$_k" ] && known=1
  done
  # Unreachable is a routing/health problem the other alerts already cover;
  # don't also raise the split-brain alert for it.
  [ "$origin" = "unreachable" ] && known=1
  # $origin is attacker-controlled — it is whatever answers the anycast
  # address, i.e. exactly the responder this check exists to distrust. Escape
  # it for the Prometheus exposition format before it becomes a label value: a
  # stray backslash (or quote) would otherwise break the textfile and silently
  # take EVERY metric in it offline, including this split-brain signal. `"` is
  # already stripped above; escape `\` (backslash first) and drop any newline.
  # printf, not echo, so the value is emitted literally rather than re-parsed.
  _origin_label=$(printf '%s' "$origin" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr -d '\n')
  printf 'netops_anycast_origin_known{ip="%s",origin="%s"} %s\n' \
    "$_ip" "$_origin_label" "$known" >> "$tmp"
done

# Reciprocal peer view: each service host checks the others by their own
# addresses, so one host's failure is observed by another.
if [ -n "$PEERS" ]; then
  {
    echo "# HELP netops_peer_dns_healthy Internal-zone probe against another service host's own address."
    echo "# TYPE netops_peer_dns_healthy gauge"
  } >> "$tmp"
  for _peer in $PEERS; do
    _name=${_peer%%=*}
    _addr=${_peer#*=}
    _ok=0
    [ "$($DIG @"$_addr" "$DNS_PROBE_NAME" A 2>/dev/null | head -1 || true)" = "$DNS_PROBE_EXPECT" ] && _ok=1
    echo "netops_peer_dns_healthy{peer=\"$_name\"} $_ok" >> "$tmp"
  done
fi

# Zone-data checksum: identical across hosts unless one missed a deploy.
if [ -r "$ZONE_FILE" ]; then
  zone_hash=$(sha256sum "$ZONE_FILE" | cut -c1-16)
  {
    echo "# HELP netops_zone_render_info Checksum of the rendered internal zone data (label value)."
    echo "# TYPE netops_zone_render_info gauge"
    echo "netops_zone_render_info{hash=\"$zone_hash\"} 1"
  } >> "$tmp"
fi

# unbound counters (cumulative since start — use rate() in queries).
stats=$(unbound-control stats_noreset 2>/dev/null || true)
if [ -n "$stats" ]; then
  queries=$(printf '%s\n' "$stats" | awk -F= '/^total.num.queries=/{print $2}')
  hits=$(printf '%s\n' "$stats" | awk -F= '/^total.num.cachehits=/{print $2}')
  servfail=$(printf '%s\n' "$stats" | awk -F= '/^num.answer.rcode.SERVFAIL=/{print $2}')
  {
    echo "# HELP netops_unbound_queries_total Queries answered since unbound started."
    echo "# TYPE netops_unbound_queries_total counter"
    echo "netops_unbound_queries_total ${queries:-0}"
    echo "# HELP netops_unbound_cache_hits_total Cache hits since unbound started."
    echo "# TYPE netops_unbound_cache_hits_total counter"
    echo "netops_unbound_cache_hits_total ${hits:-0}"
    echo "# HELP netops_unbound_servfail_total SERVFAIL answers since unbound started."
    echo "# TYPE netops_unbound_servfail_total counter"
    echo "netops_unbound_servfail_total ${servfail:-0}"
  } >> "$tmp"
fi

{
  echo "# HELP netops_site_services_last_run_timestamp_seconds Last completed health check."
  echo "# TYPE netops_site_services_last_run_timestamp_seconds gauge"
  echo "netops_site_services_last_run_timestamp_seconds $now"
} >> "$tmp"

mv "$tmp" "$TEXTFILE_DIR/netops-site-services.prom"
