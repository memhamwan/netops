---
# Oxidized configuration for the MemHamWAN RouterOS fleet.
# Deployed to /var/lib/netops/oxidized/config by the netops_host role.
# Auth: SSH publickey as device user "oxidized" (read-only, no sensitive policy),
# key at /home/oxidized/.ssh/id_ed25519 inside the container.
# Sanitized exports only: remove_secret makes the routeros model run
# "/export hide-sensitive"; the device account can't read secrets either way.
username: oxidized
# false: unresolvable nodes stay in the node list and are re-tried every
# cycle (several device names exist only in HamWAN-internal DNS, which is
# unreachable when its site is down; true would drop them permanently at load)
resolve_dns: false
interval: 3600
threads: 8
# always run the full thread pool: with many dark sites the adaptive
# scheduler degenerates to one ~90s-timeout node at a time
use_max_threads: true
timeout: 15
# hourly cycles already provide retry; per-cycle retries just slow the sweep
retries: 1
rest: 0.0.0.0:8888
next_adds_job: false
pid: /home/oxidized/.config/oxidized/pid
crash:
  directory: /home/oxidized/.config/oxidized/crashes
  hostnames: false
vars:
  ssh_port: 222
  remove_secret: true
input:
  default: ssh
  debug: false
  ssh:
    secure: false
output:
  default: git
  git:
    user: oxidized
    email: netops@memhamwan.net
    repo: /home/oxidized/.config/oxidized/devices.git
source:
  default: csv
  csv:
    file: /home/oxidized/.config/oxidized/router.db
    delimiter: !ruby/regexp /:/
    map:
      name: 0
      model: 1
hooks:
  push_to_github:
    type: exec
    events: [nodes_done]
    timeout: 180
    async: false
    cmd: 'cd /home/oxidized/.config/oxidized/devices.git && GIT_SSH_COMMAND="ssh -i /home/oxidized/.ssh/gh_deploy_ed25519 -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/home/oxidized/.ssh/known_hosts" git push git@github.com:memhamwan/routeros-config-audit.git HEAD:main'
