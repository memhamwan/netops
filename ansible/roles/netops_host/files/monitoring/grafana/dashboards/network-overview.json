{
  "uid": "net-overview",
  "title": "Network Overview",
  "tags": ["memhamwan"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {"from": "now-24h", "to": "now"},
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Devices up",
      "gridPos": {"h": 5, "w": 4, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "count(probe_success{job=\"blackbox-icmp\",kind!=\"ups\"} == 1) or vector(0)"}],
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "green"}, "unit": "none"}, "overrides": []}
    },
    {
      "id": 2, "type": "stat", "title": "Devices down",
      "gridPos": {"h": 5, "w": 4, "x": 4, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "count(probe_success{job=\"blackbox-icmp\",kind!=\"ups\"} == 0) or vector(0)"}],
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "unit": "none"}, "overrides": []}
    },
    {
      "id": 3, "type": "stat", "title": "UPSes down",
      "gridPos": {"h": 5, "w": 4, "x": 8, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "count(probe_success{job=\"blackbox-icmp\",kind=\"ups\"} == 0) or vector(0)"}],
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}]}, "unit": "none"}, "overrides": []}
    },
    {
      "id": 4, "type": "timeseries", "title": "Reachable devices by site",
      "gridPos": {"h": 10, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (site) (probe_success{job=\"blackbox-icmp\",kind!=\"ups\"})", "legendFormat": "{{site}}"}],
      "fieldConfig": {"defaults": {"custom": {"fillOpacity": 10, "lineWidth": 2}, "min": 0, "unit": "none"}, "overrides": []}
    },
    {
      "id": 5, "type": "state-timeline", "title": "Device reachability",
      "gridPos": {"h": 14, "w": 24, "x": 0, "y": 10},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "probe_success{job=\"blackbox-icmp\"}", "legendFormat": "{{site}} / {{device}}"}],
      "options": {"showValue": "never", "legend": {"showLegend": false}},
      "fieldConfig": {"defaults": {"custom": {"fillOpacity": 70}, "mappings": [{"type": "value", "options": {"0": {"text": "down", "color": "red"}, "1": {"text": "up", "color": "green"}}}], "max": 1, "min": 0}, "overrides": []}
    },
    {
      "id": 6, "type": "timeseries", "title": "ICMP round-trip (reachable devices)",
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 24},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "probe_duration_seconds{job=\"blackbox-icmp\"} and probe_success == 1", "legendFormat": "{{site}} / {{device}}"}],
      "options": {"legend": {"showLegend": true, "placement": "right"}},
      "fieldConfig": {"defaults": {"custom": {"fillOpacity": 0, "lineWidth": 1}, "unit": "s"}, "overrides": []}
    }
  ]
}
