# Managed by the netops linux_baseline role — do not edit on the host.
# Key-only, internet-facing hardening. These boxes sit on publicly-routed
# 44net, so password auth is off and only members of the login-gate group get in.
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
AuthenticationMethods publickey
PubkeyAuthentication yes
MaxAuthTries 3
LoginGraceTime 20
AllowGroups {{ linux_baseline_ssh_group }}
X11Forwarding no
AllowAgentForwarding no
# `local`, not `no`: the documented oxidized-web access path is an `ssh -L`
# local forward to port 8888 on rpi.sco (see README). Local forwarding stays;
# remote (-R) forwarding — using the host as a pivot — is still disallowed.
AllowTcpForwarding local
PermitTunnel no
ClientAliveInterval 300
ClientAliveCountMax 2
MaxSessions 6
